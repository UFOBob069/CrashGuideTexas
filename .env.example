# CrashGuide Texas - Environment Variables
# Copy this file to .env and fill in your values

# LLM API Configuration (optional - app works with built-in responses if not set)
# Supports: Kimi/Moonshot, OpenAI, Anthropic, or any OpenAI-compatible API

# --- Kimi / Moonshot (default) ---
EXPO_PUBLIC_LLM_API_URL=https://api.moonshot.cn/v1/chat/completions
EXPO_PUBLIC_LLM_API_KEY=your_kimi_api_key_here
EXPO_PUBLIC_LLM_MODEL=moonshot-v1-8k

# --- Anthropic ---
# EXPO_PUBLIC_LLM_API_URL=https://api.anthropic.com/v1/messages
# EXPO_PUBLIC_LLM_API_KEY=sk-ant-...
# EXPO_PUBLIC_LLM_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI ---
# EXPO_PUBLIC_LLM_API_URL=https://api.openai.com/v1/chat/completions
# EXPO_PUBLIC_LLM_API_KEY=sk-...
# EXPO_PUBLIC_LLM_MODEL=gpt-4o
