# CrashGuide Texas - Environment Variables
# Copy this file to .env and fill in your values

# ── Firebase Configuration ────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Google Sign-In ─────────────────────────────────────────
# Firebase Console → Authentication → Sign-in method → Google
# → Web SDK configuration (Web client ID)
# iOS/Android client IDs: Google Cloud Console → APIs & Services → Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ── LLM Proxy ──────────────────────────────────────────────
# The app calls your Vercel deployment — the real API key never
# touches the client bundle. Set the URL after deploying.
EXPO_PUBLIC_LLM_PROXY_URL=https://your-project.vercel.app/api/chat

# ── Vercel environment variables (set in Vercel dashboard, NOT here) ──
# LLM_API_KEY=sk-...           ← your OpenAI / Anthropic / Moonshot key
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# FIREBASE_WEB_API_KEY=        ← same value as EXPO_PUBLIC_FIREBASE_API_KEY
