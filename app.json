{
  "expo": {
    "name": "CrashGuide Texas",
    "slug": "CrashGuideTexas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E40AF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crashguidetexas.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CrashGuide Texas needs camera access to document accident evidence.",
        "NSPhotoLibraryUsageDescription": "CrashGuide Texas needs photo library access to attach accident photos.",
        "NSLocationWhenInUseUsageDescription": "CrashGuide Texas uses your location to tag accident evidence with GPS coordinates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E40AF"
      },
      "package": "com.crashguidetexas.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "CrashGuide Texas",
      "shortName": "CrashGuide",
      "description": "Your calm, step-by-step guide after an accident — built for Texans",
      "themeColor": "#1E40AF",
      "backgroundColor": "#1E40AF"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "f51e802f-bdc3-4078-86e7-791d81abcef9"
      }
    }
  }
}
